NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<openssl rand -base64 32>

# App: role restrita, sem superuser
DATABASE_URL=postgres://vps_monitor:<senha>@<host>:5432/vps_monitor
# Setup apenas: nunca no container da API
DATABASE_ADMIN_URL=postgres://postgres:<senha-admin>@<host>:5432/postgres

SEED_EMAIL=admin@example.com
SEED_PASSWORD=<senha-forte>

HOST_PROC=/proc
HOST_SYS=/sys
HOST_ROOT=/
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

COOLIFY_API_URL=https://coolify.example.com
COOLIFY_API_TOKEN=<token-somente-leitura>

LLM_PROVIDER=groq
GROQ_API_KEY=<chave>
LLM_MODEL=openai/gpt-oss-20b

METRICS_INTERVAL_MS=15000
METRICS_RETENTION_DAYS=30
